# Copy this file to `.env` and fill in the keys you have. `.env` is gitignored.
#
# All keys are optional — Jobe runs on whatever you provide. Without any key,
# only the public-API and HTML-scraping sources run (Greenhouse, Lever, Ashby,
# Amazon, Apple, HN), which is enough to surface a few hundred postings per run.
# Add Brave for the strongest free-tier recall.

# RECOMMENDED — Brave Search API. 2,000 queries / month free, no card.
# Get a key at https://api.search.brave.com.
# This is the highest-impact key: it powers slug-harvest (phase 0) and the
# per-(domain x role) keyword fan-out across every ATS Jobe knows about.
BRAVE_API_KEY=

# Optional — SerpAPI Google Jobs + site: search. Free tier is 100 queries / month;
# paid tier starts at $50 / month for 5,000. Adds Google Jobs aggregator coverage.
# Get a key at https://serpapi.com.
SERPAPI_KEY=

# Optional — Adzuna Jobs API (board aggregator). Free developer tier.
# Indexes listings syndicated across job boards, with clean `created` dates
# feeding the recency gate. Free key at https://developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional — JSearch via RapidAPI (Google for Jobs aggregation). Free tier.
# Aggregates Google for Jobs results (LinkedIn / Indeed / Glassdoor-listed
# postings) as structured JSON. Subscribe at
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch.
JSEARCH_API_KEY=

# Key-free sources (always on, nothing to configure): remotive, remoteok,
# weworkremotely, himalayas (remote-first boards) and linkedin-guest
# (LinkedIn's public logged-out jobs endpoint — no account, no login, and
# no automation of your own session).

# Optional — raises GitHub API rate limit from 60/hr to 5,000/hr if Jobe fetches
# company READMEs during deep-research mode. Create a fine-grained token with
# public_repo read access at https://github.com/settings/tokens.
GITHUB_TOKEN=
