# Copy this file to `.env` and fill in what you have. `.env` is gitignored.
#
# Every value is optional. Jobe runs on whatever you provide: a source whose
# key is missing logs one line and is skipped, and the run continues. A line
# left blank counts as unset.
#
# `.env` files are read in this order, and the first value found wins per key
# (a variable already set in your shell always wins):
#   1. <workspace>/.env      your own keys (users/<name>/.env, or the install
#                            root when no workspace is configured)
#   2. <install root>/.env   keys shared by every workspace on this machine
#   3. ~/.jobe/.env
#
# What each key adds: BRAVE_API_KEY turns on the keyword search across employer
# job boards; SERPAPI_KEY adds the Google Jobs searches. With neither, the key
# free sources listed further down still run, and `/jobe find` falls back to
# the agent's own web search when too few postings come back.

# ----------------------------------------------------------------------------
# Search keys
# ----------------------------------------------------------------------------

# RECOMMENDED: Brave Search API. 2,000 queries per month free, no card.
# Get a key at https://api.search.brave.com.
# This is the key with the most effect: it finds employer job boards in your
# field (slug harvest, about 36 queries per run) and searches every applicant
# tracking system Jobe knows for your seed role titles.
BRAVE_API_KEY=

# Optional: SerpAPI (Google Jobs plus site search). The free tier is 100
# queries per month, so use it with a paid plan or not at all. Get a key at
# https://serpapi.com.
SERPAPI_KEY=

# Optional: Adzuna Jobs API (board aggregator). Free developer tier.
# Listings syndicated across job boards, with a clean posting date.
# Free key at https://developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: JSearch through RapidAPI (Google for Jobs results as JSON). Free
# tier. Subscribe at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch.
# RAPIDAPI_KEY is accepted as another name for the same key.
JSEARCH_API_KEY=

# Optional: Findwork.dev Jobs API. The board lists software and technology
# roles, so it returns little for other fields. Free token at
# https://findwork.dev/developers/.
FINDWORK_API_KEY=

# Optional: Jooble Jobs API (global aggregator; a key is issued per country).
# Free key through the form at https://jooble.org/api/about. The free plan is
# 500 requests for the life of the key, so Jobe sends at most 4 per run.
JOOBLE_API_KEY=

# Optional: USAJOBS (US federal government jobs, every profession). Free key
# at https://developer.usajobs.gov/apirequest/. BOTH values are required: the
# API wants the email the key was registered with as the User-Agent header.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ----------------------------------------------------------------------------
# Sources with no key
# ----------------------------------------------------------------------------

# Key free sources (always on, nothing to configure): remotive, remoteok,
# weworkremotely, himalayas, jobicy, working-nomads, arbeitnow, themuse, and
# linkedin-guest (LinkedIn's public logged out jobs endpoint: no account, no
# login, no automation of your own session). The per company crawlers
# (greenhouse, lever, ashby, workable, recruitee, breezy, bamboohr, personio,
# workday, smartrecruiters, icims) are key free too and run once your company
# index or your own employer seed files name an employer.

# Optional: narrow The Muse to your field. Comma separated category names as
# the site spells them (for example: Healthcare,Accounting and Finance).
# Unset means no category: the newest pages are read and filtered by title.
THEMUSE_CATEGORIES=

# Optional: extra We Work Remotely category feeds for your own field, comma
# separated category slugs as they appear in the site's feed addresses (for
# example: remote-customer-support-jobs,remote-finance-and-legal-jobs).
# Unset means only the catch all feed, which already covers every category.
WWR_CATEGORIES=

# Optional: pages read per query by linkedin-guest (default 2). More pages
# bring more candidate postings and more employer names for your company
# index. Every posting found this way still has to be verified against the
# employer's own listing before it is presented.
# LINKEDIN_GUEST_PAGES=2

# Opt in, off by default: hiring.cafe. Its robots.txt disallows the search
# URL pattern this source reads, so it runs only when you turn it on for
# personal, low volume use. Set to 1 to enable.
HIRING_CAFE_OPT_IN=

# Opt in, off by default: Indeed public search through a stealth browser
# (logged out, never signs in, stops on any verification page). Set to 1 to
# enable.
INDEED_CAMOUFOX_ENABLED=
# Optional tuning for that source, shown with the defaults: seed roles searched
# per run (1 to 20), result pages per query (1 to 5), postings opened per page
# for detail (0 to 10), wait between result pages in milliseconds (2000 to
# 30000), and headless mode (set 0 to watch the browser).
# INDEED_CAMOUFOX_MAX_QUERIES=3
# INDEED_CAMOUFOX_PAGES=1
# INDEED_CAMOUFOX_DETAILS=5
# INDEED_CAMOUFOX_DELAY_MS=4000
# INDEED_CAMOUFOX_HEADLESS=1

# ----------------------------------------------------------------------------
# Switches read from the shell environment only (NOT from this file)
# ----------------------------------------------------------------------------
# These are read by scripts that do not load `.env`, or they decide which
# `.env` is loaded in the first place. Set them on the command line, for
# example:  JOBE_USER=<name> node collectors/pipeline.js
#
#   JOBE_USER=<name>            use this workspace for one command (wins over
#                               the active workspace set by `/jobe use`)
#   JOBE_USER_ROOT=<abs path>   use this directory as the workspace (absolute
#                               path; wins over JOBE_USER). Tests and smoke
#                               runs point it at a temporary folder.
#   JOBE_CONFIG=<path>          read this file in place of configs/default.json
#   JOBE_STRICT_AUDIT=1         resume and cover letter renders stop on a failed
#                               quality check (same as passing --strict)
#   JOBE_EVIDENCE_ROOTS=<a:b>   extra folders of your own work for
#                               scripts/evidence-index.js, joined with your
#                               system's path separator
#   LINKEDIN_SWEEP_MAX_QUERIES=20   seed roles searched by
#                               scripts/linkedin-guest-sweep.js (it also reads
#                               LINKEDIN_GUEST_PAGES)
#   RESOLVE_LIMIT=700           company index entries handled per run of
#                               scripts/resolve-index-backlog.js
#   JOBE_INSTALL_SKIP_DEPS=1    install-local.sh copies files only (no
#                               `npm install`, no browser download)
