# Copy to .env and populate. .env is gitignored.

# Optional — enables SerpAPI-backed sources (Google Jobs + site: search).
# Without this, only Greenhouse / Lever / Ashby / Amazon / Apple / HN sources run.
SERPAPI_KEY=

# Optional — raises GitHub API rate limit from 60/hr to 5000/hr if Jobe fetches company READMEs.
GITHUB_TOKEN=
