# Dependencies
node_modules/
/package-lock.json
pnpm-lock.yaml
yarn.lock

# Next.js build output (under web/)
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts

# Environment / secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

