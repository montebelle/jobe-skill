data/contacts.json
data/resume-baseline.json
data/bullet-library.json
data/companies/index.json
data/apply-profile.json

# Run artifacts (anchored to repo root so web/src/{components,app}/reports/
# are not caught by the pattern)
/signals/
/reports/
/output/
configs/_temp-*

# Per-user workspaces (personal data for every person on this machine)
/users/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Build / rendered outputs
*.pptx
*.docx
*.pdf

# Logs
*.log
npm-debug.log*
